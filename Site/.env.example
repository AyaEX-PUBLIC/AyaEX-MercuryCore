ORIGIN=https://mercs.dev
PORT=4443
# https://svelte.dev/docs/kit/adapter-node#Environment-variables-BODY_SIZE_LIMIT
BODY_SIZE_LIMIT=1G
EMAIL_PASSWORD=password
RCC_KEY=password
GAMESERVER_KEY=password
OPEN_CLOUD_KEY=whatever
# A Roblox account's .ROBLOSECURITY cookie, for fetching assets from Roblox.
# Roblox ends a login used from somewhere other than where it was made, so only
# set it on the machine whose address made it (on a VPS: /etc/mercury/site.env).
# ROBLOSECURITY=

# The password, port, and RCCService key may be changed if required.
