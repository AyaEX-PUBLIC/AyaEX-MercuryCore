# Local Mercury Core + Aya deployment, served at http://localhost:8010.
# localhost is a secure context, so the multithreaded Aya WebAssembly Player
# works over plain HTTP. For a public deployment, use an HTTPS site address and
# set ORIGIN/Domain to match.

# Trust the local Caddy/loopback proxy in front of the Site (the VPS Caddy
# imports this file), so {client_ip} below is the visitor's address rather than
# 127.0.0.1 for every request. Direct visitors to :8010 are not trusted.
{
	servers {
		trusted_proxies static 127.0.0.1 ::1
	}
}

# Only signed-in players can load the Aya runtime: the Site checks the
# session (and moderation, and the recovery phrase) for every /runtime
# request, and turns away or redirects anyone else
(runtime_auth) {
	forward_auth 127.0.0.1:4443 {
		uri /runtime-access
	}
}

:8010 {
	# Unified Aya WebAssembly runtime. Multithreaded Wasm needs cross-origin
	# isolation, so the launcher and its assets carry COOP/COEP.
	# Client channels: the Site sets this cookie from the user's settings
	# (Site/src/lib/clientChannels.ts). dev is the live aya-dev build output,
	# which is missing or half-written while the client builds and links;
	# stable is a snapshot made by aya/promote-stable.sh.
	map {http.request.cookie.ayaClientChannel} {aya_runtime_root} {
		dev /srv/runtime-dev
		default /srv/runtime-channels/stable
	}

	@runtimeAll path /runtime /runtime/ /runtime/*
	header @runtimeAll {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
	}

	@runtimeLauncher path /runtime /runtime/
	handle @runtimeLauncher {
		import runtime_auth
		header Cache-Control "no-store"
		root * {aya_runtime_root}
		rewrite * /Aya.App.html
		file_server
	}
	handle_path /runtime/* {
		import runtime_auth
		# versioned URLs are immutable; anything else revalidates. Private,
		# so shared caches (Cloudflare) never hand them to signed-out visitors
		# (only on files actually served, never on a refusal from runtime_auth)
		@versioned query v=*
		header @versioned {
			Cache-Control "private, max-age=31536000, immutable, no-transform"
			match status 200
		}
		@unversioned not query v=*
		header @unversioned Cache-Control "no-cache"
		root * {aya_runtime_root}
		# (welcome.html and aya-studio.png: Studio's Start page; Aya.App.js.symbols:
		# function names for crash reports)
		@unknownRuntimeAsset not path /Aya.App.js /Aya.App.wasm /Aya.App.data /Aya.App.Brand.png /Aya.GameWebRtc.js /Aya.App.StreamingFrame.js /Aya.Diagnostics.js /welcome.html /aya-studio.png /Aya.App.js.symbols
		respond @unknownRuntimeAsset 404
		file_server
	}

	# Game connections: the Orbiter proxies a WebSocket to the native
	# Aya.Server hosting that place, only while it is running.
	@gameserver path_regexp gameserver ^/gameserver/([0-9]+)$
	handle @gameserver {
		rewrite * /play/{re.gameserver.1}
		reverse_proxy 127.0.0.1:64992
	}

	# StreamingFrame signaling: a WebSocket relay in the Site process, on its
	# own port (STREAMING_PORT in compose.yml, Site lib/server/streaming.ts)
	handle /streaming/ws {
		reverse_proxy 127.0.0.1:4444
	}

	# Orbiter public status (server-sent events while a gameserver starts)
	handle_path /orbiter/* {
		reverse_proxy 127.0.0.1:64992 {
			flush_interval -1
		}
	}

	# Large uploads go to the upload-only Site instance, whose adapter body
	# limit is 101MB. Everything else is held to 1MB below. The regexp mirrors
	# Site/src/lib/server/requestLimits.ts.
	@uploads {
		method POST PUT PATCH
		path_regexp upload ^/(?:place/[0-9]+/[^/]+/settings(?:/|$)|studio/api/places/[0-9]+/file$|develop/create$|admin/(?:create|news)$)
	}
	handle @uploads {
		request_body {
			max_size 101MB
		}
		timeouts {
			read_timeout 2m 1024
			write_timeout 2m
		}
		reverse_proxy 127.0.0.1:4445 {
			flush_interval -1
			# passive health check doubles as a concurrency cap: past this many
			# simultaneous uploads the backend is treated as overloaded
			fail_duration 10s
			unhealthy_request_count 8
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 2m
				write_timeout 2m
				max_conns_per_host 8
			}
		}
	}

	# Mercury Core Site, with the client compatibility rewrites from Site/Caddyfile
	handle {
		# Edge limits for the public, unauthenticated endpoints. The Site has
		# its own token buckets too (lib/server/requestRateLimit.ts), so neither layer
		# is the only protection.
		rate_limit {
			zone auth_ip {
				match {
					method POST
					path /api/auth* /api/switch* /login* /register* /recover* /device*
				}
				key {client_ip}
				events 30
				window 1m
				ipv6_prefix 64
			}
			zone apply_ip {
				match {
					method POST
					path /apply* /api/apply*
				}
				key {client_ip}
				events 10
				window 10m
				ipv6_prefix 64
			}
		}

		# The public instance only ever needs small bodies; uploads take the
		# @uploads route above. Counted by Caddy while streaming.
		request_body {
			max_size 1MB
		}
		timeouts {
			read_timeout 30s 1024
			write_timeout 2m
		}

		rewrite /Asset /asset
		rewrite /Asset/ /asset
		rewrite /Asset/Default.ashx /asset
		# assetdelivery-style URLs, which places and the engine also use
		rewrite /v1/asset /asset
		rewrite /v1/asset/ /asset

		rewrite /Game/Studio.ashx /game/studio
		rewrite /Game/Visit.ashx /game/visit
		rewrite /Game/Join.ashx /game/join
		rewrite /game/gameserver.ashx /game/gameserver
		rewrite /Game/MachineConfiguration.ashx /game/machineconfiguration
		rewrite /Game/ClientPresence /game/clientpresence
		rewrite /Game/ServerPresence /game/serverpresence
		rewrite /Game/Host /game/host
		rewrite /Asset/GetScriptState.ashx /asset/getscriptstate
		rewrite /Game/Tools/InsertAsset.ashx /game/tools/insertasset
		rewrite /Game/Tools/ThumbnailAsset.ashx /game/tools/thumbnailasset
		rewrite /UploadMedia/PostImage.aspx /studio/uploadmedia/screenshot
		rewrite /asset/bodycolors.ashx /asset/bodycolors
		rewrite /Game/PlaceLauncher.ashx /game/placelauncher

		rewrite /Setting/QuietGet/ClientSharedSettings/* /api/clientsharedsettings/2016
		rewrite /Setting/QuietGet/ClientSharedSettings /api/clientsharedsettings/2016
		rewrite /Setting/QuietGet/ClientAppSettings/* /api/clientappsettings/2016
		rewrite /Setting/QuietGet/ClientAppSettings /api/clientappsettings/2016
		rewrite /Setting/QuietGet/AndroidAppSettings/* /api/clientappsettings/2016
		rewrite /Setting/QuietGet/AndroidAppSettings /api/clientappsettings/2016

		rewrite /GetAllowedSecurityVersions/* /api/getallowedsecurityversions
		rewrite /GetAllowedSecurityVersions /api/getallowedsecurityversions
		rewrite /GetAllowedMD5Hashes/* /api/getallowedmd5hashes
		rewrite /GetAllowedMD5Hashes /api/getallowedmd5hashes

		rewrite /Error/Dmp.ashx /dmp

		rewrite /universes/validate-place-join /api/validateplacejoin

		# the engine's web API calls put a second slash after the host
		# (https://host//users/...): the developer console's canmanage check
		@canManage path_regexp canManage ^/+(users/[0-9]+/canmanage/[0-9]+)$
		rewrite @canManage /{re.canManage.1}

		# in-game store and badges (Site lib/server/store.ts)
		rewrite /Game/GamePass/GamePassHandler.ashx /game/gamepass/haspass
		rewrite /game/gamepass/gamepasshandler.ashx /game/gamepass/haspass
		rewrite /ownership/hasAsset /ownership/hasasset

		# friends and follows (Site routes game/social/*, lib/server/social.ts)
		rewrite /Game/LuaWebService/HandleSocialRequest.ashx /game/social/handlesocialrequest
		rewrite /user/following-exists /game/social/following-exists
		rewrite /user/multi-following-exists /game/social/multi-following-exists
		rewrite /user/get-friendship-count /game/social/get-friendship-count
		# /user/follow and /user/unfollow are also profile URLs (/user/{name});
		# profile buttons always post a form action (?/follow), the Player never does
		@engineFollow {
			method POST
			path /user/follow
			expression {http.request.uri.query} == ""
		}
		rewrite @engineFollow /game/social/follow
		@engineUnfollow {
			method POST
			path /user/unfollow
			expression {http.request.uri.query} == ""
		}
		rewrite @engineUnfollow /game/social/unfollow
		# gameservers check and complete developer product receipts with a
		# form-encoded or text/plain POST and no Origin header, which SvelteKit's
		# cross-site form check would reject; the routes authenticate them with
		# the server key instead
		@receiptComplete path /gametransactions/settransactionstatuscomplete /gametransactions/settransactionstatuscomplete/ /marketplace/validatepurchase /marketplace/validatepurchase/
		request_header @receiptComplete Content-Type application/octet-stream
		# the WebAssembly Player posts its request bodies as raw bytes, with no
		# Content-Type, and SvelteKit's node adapter drops a body that has none:
		# in-game purchases (marketplace/submitpurchase, marketplace/purchase) and
		# follows arrived with no parameters. engineParams reads any type, and
		# octet-stream isn't a form type for the cross-site form check
		@untypedBody {
			method POST PUT PATCH
			not header Content-Type *
		}
		request_header @untypedBody Content-Type application/octet-stream

		reverse_proxy 127.0.0.1:4443 {
			flush_interval -1
			# a hard backstop against connection floods reaching the Site; the
			# application rate limits are the primary limit
			fail_duration 10s
			unhealthy_request_count 200
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 2m
				write_timeout 2m
				max_conns_per_host 200
			}
		}
	}
}
