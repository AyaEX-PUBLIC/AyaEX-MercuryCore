# Discord bot that hands out Mercury registration keys (see README.md)

# Bot token from https://discord.com/developers/applications (Bot -> Token)
DISCORD_TOKEN=
# Right-click -> Copy ID (enable Developer Mode in Discord's Advanced settings)
DISCORD_GUILD_ID=
# the only channel where /invite works
DISCORD_CHANNEL_ID=
# members need this role to get a key
DISCORD_ROLE_ID=

SITE_URL=https://mercury.nodium.lol
# The site name and key prefix are read from mercury.core.ts (mounted into the
# container); SITE_NAME and KEY_PREFIX are only fallbacks if it can't be read
# accounts each key can create
KEY_USES=1

# SurrealDB, reached over the compose network
DB_URL=ws://database:8000
DB_USERNAME=root
DB_PASSWORD=root
