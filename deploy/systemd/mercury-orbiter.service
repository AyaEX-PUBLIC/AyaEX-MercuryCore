# Orbiter (MercuryRCC/Orbiter): starts gameservers and proxies players to them
[Unit]
Description=Mercury: Orbiter
After=network-online.target mercury-rcc-proxy.service
Wants=network-online.target mercury-rcc-proxy.service

[Service]
User=mercury
WorkingDirectory=@ROOT@/MercuryRCC/Orbiter
ExecStart=@ROOT@/MercuryRCC/Orbiter/Orbiter
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
