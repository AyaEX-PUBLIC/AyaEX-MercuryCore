# RCC proxy (MercuryRCC/Proxy): renders and hosted gameservers with Aya.Server
[Unit]
Description=Mercury: RCC proxy
After=network-online.target docker.service mercury-xvfb.service
Wants=network-online.target docker.service
Requires=mercury-xvfb.service

[Service]
User=mercury
WorkingDirectory=@ROOT@/MercuryRCC/Proxy
Environment=DISPLAY=:99
# Aya.Server's runpath is the build machine's; FMOD sits next to it here
Environment=LD_LIBRARY_PATH=@ROOT@/aya-dev/build/x64-linux-rel/bin
ExecStart=@ROOT@/MercuryRCC/Proxy/Proxy
# hosted gameservers are containers: stop them with the proxy
# ($$ is a literal $ for systemd)
ExecStopPost=/bin/sh -c 'ids="$$(docker ps --quiet --filter label=mercury.gameserver)"; [ -z "$$ids" ] || docker stop --time 5 $$ids'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
