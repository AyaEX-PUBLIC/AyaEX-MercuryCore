# Public deployment on a VPS (deploy/deploy.sh fills in the domain and the
# site-wide login, if any, and installs this as deploy/Caddyfile.vps there).
#
# The :8010 site is the same as at home (Caddyfile.aya). In front of it is
# HTTPS for the public domain, with a Cloudflare origin certificate. The VPS
# resolves the domain to itself (/etc/hosts), so its gameservers and renders
# reach the site here directly instead of through Cloudflare, and only
# requests from elsewhere need the site-wide login, if there is one.
import /etc/caddy/Caddyfile.aya

__DOMAIN__ {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
__AUTH__
	# The :8010 site enforces the real per-route limits; this is a hard outer
	# bound so no upload can reach the Site unbounded, and keeps stalled
	# uploads/downloads from holding a connection forever. It applies to both
	# the live Site and the maintenance page below.
	request_body {
		max_size 101MB
	}
	timeouts {
		read_timeout 2m 1024
		write_timeout 2m
	}

	# deploy/maintenance.sh on|off: a static page instead of the Site, without
	# a Caddy restart. data/maintenance/live exists whenever the Site should
	# be shown (data/ is untouched by deploy.sh, so this state outlives a
	# deploy); deploy/maintenance/ is the page, sent like the rest of the code.
	@live {
		file {
			root /srv/maintenance-state
			try_files live
		}
	}
	handle @live {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 2m
				write_timeout 2m
				max_conns_per_host 200
			}
		}
	}
	handle {
		root * /srv/maintenance-content
		file_server
	}
}

# The standalone AyaEX site (deploy/compose.standalone.yml) on its own domain,
# when STANDALONE_DOMAIN is set (deploy.sh leaves this part out otherwise)
# __STANDALONE_BEGIN__
__STANDALONE_DOMAIN__ {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
__STANDALONE_AUTH__
	reverse_proxy 127.0.0.1:8005 {
		flush_interval -1
	}
}
# __STANDALONE_END__

# Engine URLs use http:// (DomainInsecure): served directly for the VPS
# itself, and sent to HTTPS for everyone else
http://__DOMAIN__ {
	@vps remote_ip 127.0.0.1 ::1
	handle @vps {
		reverse_proxy 127.0.0.1:8010 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 2m
				write_timeout 2m
				max_conns_per_host 200
			}
		}
	}
	handle {
		redir https://{host}{uri} 308
	}
}
