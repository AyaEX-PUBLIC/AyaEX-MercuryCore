# Settings for deploy/deploy.sh. Copy to deploy/vps.env (ignored by git).

# SSH destination of a Debian 13 VPS (root, or a user with passwordless sudo
# is not supported: use root)
VPS=root@203.0.113.1

# Public address, behind Cloudflare (SSL/TLS mode "Full (strict)")
DOMAIN=mercury.example.com

# Cloudflare origin certificate and its key for DOMAIN
TLS_CERT=/path/to/origin.pem
TLS_KEY=/path/to/origin.key

# Optional login for the whole site (HTTP basic auth), asked of every visitor.
# The VPS's own gameservers and renders don't need it. Leave empty for none.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Where everything lives on the VPS
REMOTE_ROOT=/opt/mercury

# Where deploy/release.sh keeps releases on this machine (default: next to
# this repository, in mercury-releases)
# RELEASES=/path/to/mercury-releases
